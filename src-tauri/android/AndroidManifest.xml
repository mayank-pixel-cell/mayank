<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Arc Tracker Android Hardware & Compatibility Manifest
  Enforces hardware requirements to mark extremely lower-end devices 
  incompatible to download from the Google Play Store and app marketplaces.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.arctracker.app">

    <!-- Requires OpenGL ES 3.0+ hardware acceleration (excludes ancient GPU hardware) -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Requires normal device RAM (disallows low-RAM / Android Go budget devices < 2GB) -->
    <uses-feature
        android:name="android.hardware.ram.normal"
        android:required="true" />

    <!-- Requires hardware touchscreen and multi-touch capability -->
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="true" />

    <!-- Disallows low-power watch or legacy TV form factors -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="false" />

    <application
        android:label="Arc Tracker"
        android:icon="@mipmap/ic_launcher"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
